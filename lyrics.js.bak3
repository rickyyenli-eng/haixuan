"b704eb7a5d":[[10.7, 11.9, "你走以後"], [11.9, 18.4, "我還是照你的方式"], [21.14, 27.64, "活著"], [33.31, 39.81, "你教我 咖啡要留三分之一放涼"], [51.26, 57.76, "你教我 下雨天要走騎樓的右邊"], [57.98, 60.22, "你教我 難過的時候"], [60.22, 63.26, "先吃飯 再哭"], [63.26, 67.0, "現在我一個人"], [67.0, 71.32, "還是留三分之一"], [71.32, 74.66, "還是走右邊"], [74.66, 77.98, "還是先吃飯"], [77.98, 80.1, "只是沒有人"], [80.1, 81.24, "在對面"], [81.24, 84.26, "等我哭完"], [84.26, 87.14, "最狠的不是離開"], [87.14, 89.0, "是你把我"], [89.0, 91.46, "教得這麼好"], [91.46, 94.02, "好到我每一個動作"], [94.02, 98.48, "都是你的痕跡"], [98.48, 100.84, "你變成我的壞習慣"], [100.84, 104.54, "戒不掉 也不想戒"], [104.54, 106.6, "我把你活成"], [106.6, 109.02, "每天的例行公事"], [109.02, 110.86, "醒來 想你"], [110.86, 112.48, "吃飯 想你"], [112.48, 114.0, "連想你這件事"], [114.0, 116.78, "都變得很熟練"], [116.78, 120.68, "你已經不在了"], [120.68, 121.96, "可你還在"], [121.96, 126.06, "指揮我的一天"], [126.06, 128.48, "我試著換一條路回家"], [128.48, 132.8, "第三天就走回原本那條"], [132.8, 135.04, "我試著換一家店"], [135.04, 138.76, "點的還是你會點的那杯"], [138.76, 140.86, "我以為換掉環境"], [140.86, 142.46, "就能換掉我"], [142.46, 144.36, "原來要換掉的"], [144.36, 146.44, "是那個"], [146.44, 152.26, "被你改造過的自己"], [152.26, 154.78, "如果我把習慣戒掉"], [154.78, 156.38, "是不是連你"], [156.38, 159.02, "都會被戒掉"], [159.02, 161.58, "如果連你都沒有了"], [161.58, 165.68, "那我還剩下什麼"], [165.68, 168.08, "你變成我的壞習慣"], [168.08, 170.52, "我明知道 還是照做"], [170.52, 171.64, "一遍 一遍"], [171.64, 172.9, "一遍 一遍"], [172.9, 175.42, "我不是還愛你"], [175.42, 178.11, "我是還沒學會"], [178.11, 181.44, "沒有你的動作"], [181.44, 182.92, "停下來啊"], [182.92, 186.2, "停下來啊"], [186.2, 188.22, "為什麼我的手"], [188.22, 189.36, "比我的心"], [189.36, 193.92, "還要記得你"], [193.92, 196.64, "今天"], [196.64, 199.36, "我把咖啡喝完了"], [199.36, 201.71, "一滴都沒有留"], [201.71, 203.06, "它有點涼"], [203.06, 205.34, "有點苦"], [205.34, 206.06, "可是"], [206.06, 212.56, "是我的"], [219.98, 222.98, "你曾經是我的壞習慣"], [222.98, 224.02, "現在只是"], [224.02, 226.76, "一個舊動作"], [226.76, 228.85, "有時候還是會做"], [228.85, 231.39, "有時候做到一半"], [231.39, 233.33, "會停"], [233.33, 235.96, "那沒關係"], [235.96, 239.04, "習慣會慢慢變成"], [239.04, 241.16, "記得"], [241.16, 244.86, "記得會慢慢變成"], [244.86, 248.16, "還好"], [248.16, 250.12, "下雨天"], [250.12, 254.14, "我走在騎樓左邊"], [254.14, 256.36, "沒有淋濕"], [256.36, 257.8, "也沒有"], [257.8, 261.8, "想你太久"]],
