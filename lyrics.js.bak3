"cf0cf54f71":[[12.96, 14.86, "安全帶 喀一聲"], [14.86, 16.28, "把我扣在"], [16.28, 19.86, "剛剛好的距離"], [19.86, 22.64, "你說順路 那就上車吧"], [22.64, 25.58, "其實我家 在反方向"], [25.58, 27.7, "我按掉導航的提醒"], [27.7, 28.82, "讓它以為"], [28.82, 30.61, "我們沒有要去哪"], [30.61, 34.04, "儀表板的光 照著你的側臉"], [34.04, 37.42, "我把視線 放在前擋玻璃"], [37.42, 39.86, "可是玻璃會反射"], [39.86, 41.72, "把我出賣得剛剛好"], [41.72, 44.3, "你問我 要不要放歌"], [44.3, 45.77, "我說都可以"], [45.77, 47.53, "其實我想說"], [47.53, 50.2, "這首 我聽了一整年"], [50.2, 51.38, "每一次"], [51.38, 53.52, "都在想你"], [53.52, 55.86, "我坐在你的右邊"], [55.86, 59.1, "中間只有一個扶手的距離"], [59.1, 61.06, "近到能聽見"], [61.06, 62.57, "你換氣的縫隙"], [62.57, 64.46, "遠到不能問你"], [64.46, 66.92, "這條路 要開去哪裡"], [66.92, 69.64, "副駕駛的規矩是"], [69.64, 71.16, "不能碰方向盤"], [71.16, 72.24, "只能陪你"], [72.24, 78.74, "往你要的方向 偏"], [81.28, 85.4, "紅燈的時候 你會轉頭看我"], [85.4, 87.75, "我就假裝 在看窗外"], [87.75, 90.12, "路燈一格一格"], [90.12, 92.2, "把心跳 量成節拍"], [92.2, 94.54, "你說我最近好像變安靜"], [94.54, 95.59, "我笑一笑"], [95.59, 98.3, "沒說 安靜的人"], [98.3, 102.18, "其實正在很大聲地"], [102.18, 103.24, "喜歡你"], [103.24, 105.12, "如果我說出來"], [105.12, 105.9, "這條路"], [105.9, 109.35, "會不會就不能再開"], [109.35, 110.74, "如果我不說"], [110.74, 112.46, "是不是就能"], [112.46, 115.2, "一直坐在這裡"], [115.2, 117.64, "我坐在你的右邊"], [117.64, 119.57, "把喜歡調成靜音"], [119.57, 120.96, "近到能數清"], [120.96, 122.66, "你袖口的皺褶"], [122.66, 124.36, "遠到只能祝你"], [124.36, 125.54, "一路 順利"], [125.54, 127.7, "副駕駛的規矩是"], [127.7, 129.09, "不能問終點"], [129.09, 131.48, "只能在每一個路口"], [131.48, 132.46, "悄悄希望"], [132.46, 133.8, "你不要轉彎"], [133.8, 136.96, "車停在我家樓下"], [136.96, 138.24, "你說 到了"], [138.24, 140.5, "我解開安全帶"], [140.5, 142.2, "用了比平常"], [142.2, 143.34, "慢三秒"], [143.34, 144.58, "那三秒裡"], [144.58, 147.02, "我把一整年的話"], [147.02, 147.76, "說完了"], [147.76, 149.88, "你沒有聽見"], [149.88, 153.06, "那就好"], [153.06, 155.36, "我坐過你的右邊"], [155.36, 156.42, "那就夠了"], [156.42, 158.77, "夠我在很多個夜裡"], [158.77, 160.5, "重播那條路"], [160.5, 161.74, "如果有一天"], [161.74, 163.48, "換別人坐在那裡"], [163.48, 164.4, "我會記得"], [164.4, 166.13, "副駕駛的座椅"], [166.13, 167.26, "是溫的"], [167.26, 169.2, "那是我留下的"], [169.2, 174.2, "唯一的痕跡"], [174.2, 178.42, "安全帶 喀一聲"], [178.42, 180.76, "解開了"], [180.76, 187.26, "謝謝你載我"], [206.2, 210.2, "這麼久"]],
