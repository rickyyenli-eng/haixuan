"383335ef12":[[10.58, 15.48, "別回答 別回答"], [15.48, 20.88, "讓名字先離開我一下"], [20.88, 24.12, "如果世界只剩呼吸"], [24.12, 27.64, "我還是不是我啊"], [27.64, 32.62, "凌晨三點 天花板在旋轉"], [32.62, 35.06, "我把名字拆成無數個答案"], [35.06, 37.38, "每一個我 都比昨天勇敢"], [37.38, 39.76, "每一個我 又在下一秒推翻"], [39.76, 42.0, "我說可以 回音說不行"], [42.0, 44.72, "我向前一步 影子退兩步"], [44.72, 46.91, "明明還活著 卻一直證明"], [46.91, 49.5, "證明我有資格成為自己"], [49.5, 50.8, "燈一閃 一滅"], [50.8, 52.1, "心一明 一暗"], [52.1, 53.43, "我把自己推向光"], [53.43, 55.0, "又親手拉回黑暗"], [55.0, 56.38, "越靠近"], [56.38, 57.25, "越逃離"], [57.25, 58.68, "到底哪一個聲音"], [58.68, 59.76, "才是真的自己"], [59.76, 62.6, "我是我的噪音"], [62.6, 64.68, "也是我的回音"], [64.68, 67.18, "一半把我推向光"], [67.18, 69.84, "一半把我按回重力"], [69.84, 72.34, "我說我不行"], [72.34, 74.74, "又說我可以"], [74.74, 77.0, "如果兩個聲音都是真的"], [77.0, 78.5, "那就讓它們"], [78.5, 85.0, "一起呼吸"], [86.4, 92.9, "玻璃窗上 貼滿別人的星圖"], [102.46, 105.1, "每一條軌道 都寫好了去處"], [105.1, 107.35, "我沿著標準走了太久"], [107.35, 109.72, "竟忘了偏航 也可以是路"], [109.72, 112.32, "他們說飛得高 才叫自由"], [112.32, 114.67, "我把翅膀摺成一把尺"], [114.67, 117.1, "一寸一寸 量自己的不足"], [117.1, 118.16, "直到連天空"], [118.16, 119.09, "都變得太窄"], [119.09, 119.68, "再像一點"], [119.68, 121.06, "再好一點"], [121.06, 121.96, "再把自己"], [121.96, 123.28, "修成正確的形狀"], [123.28, 125.07, "可我越接近答案"], [125.07, 126.28, "越看不見"], [126.28, 128.5, "那個最不像答案的我"], [128.5, 129.46, "去了哪裡"], [129.46, 131.98, "我是我的噪音"], [131.98, 134.48, "也是我的回音"], [134.48, 137.22, "一半想證明存在"], [137.22, 139.86, "一半只想關掉聲音"], [139.86, 142.3, "我說我值得"], [142.3, 144.48, "又說我不配"], [144.48, 145.76, "繞著同一顆心"], [145.76, 147.18, "一圈 一圈"], [147.18, 148.42, "沒有終點"], [148.42, 148.82, "停"], [148.81, 150.72, "把掌聲關掉"], [150.72, 152.64, "把比較關掉"], [152.64, 153.96, "把明天也關掉"], [153.96, 155.14, "讓那個拼命"], [155.14, 156.4, "想成為誰的我"], [156.4, 157.24, "就在這裡"], [157.24, 157.64, "碎掉"], [157.61, 158.91, "碎成沒有名字的光"], [158.91, 160.26, "碎成沒有答案的我"], [160.26, 161.32, "我以為崩潰"], [161.32, 162.24, "就是墜落"], [162.24, 163.02, "原來只是"], [163.02, 163.42, "終於"], [163.37, 163.77, "鬆手"], [163.74, 164.92, "沒有更好"], [164.92, 165.7, "沒有更壞"], [165.7, 166.94, "沒有哪一個我"], [166.94, 168.31, "需要被淘汰"], [168.31, 170.2, "我第一次聽見"], [170.2, 172.1, "自己的呼吸"], [172.1, 174.29, "它沒有替我辯解"], [174.29, 177.26, "沒有告訴我應該去哪裡"], [177.26, 178.54, "它只是說"], [178.54, 181.82, "我在這裡"], [181.82, 183.1, "我是我的噪音"], [183.1, 184.2, "也是我的回音"], [184.2, 190.29, "我不必消滅哪一個自己"], [190.29, 190.69, "才算完整的生命"], [190.69, 191.09, "讓懷疑坐在左邊"], [191.08, 192.16, "讓勇氣坐在右邊"], [192.16, 193.26, "我帶著它們一起"], [193.26, 194.62, "穿過自己的天際"], [194.62, 195.88, "在我的星球裡"], [195.88, 197.11, "沒有正確的重力"], [197.11, 199.04, "我不用飛向任何人"], [199.04, 200.6, "才能證明我會飛"], [200.6, 201.49, "如果明天"], [201.49, 202.39, "我又懷疑"], [202.39, 203.5, "那也沒關係"], [203.5, 205.14, "我會繞回自己的心"], [205.14, 206.4, "再一次"], [206.4, 208.82, "認出自己"], [208.82, 210.48, "我就是我"], [210.48, 212.94, "不必同意"], [212.94, 214.02, "我就是我"], [214.02, 215.89, "還在呼吸"], [215.89, 217.54, "張開雙手"], [217.54, 219.69, "讓世界失去重力"], [219.69, 220.61, "這一次"], [220.61, 221.01, "我。"], [220.92, 222.15, "不去哪裡"], [222.15, 223.37, "我只是在"], [223.37, 224.83, "自己的天空裡"], [224.83, 225.23, "飛行"], [224.9, 225.3, "我說我不行"], [225.08, 225.48, "我說我可以"], [225.25, 225.65, "兩個聲音"], [225.39, 225.79, "慢慢重疊在一起"], [225.63, 226.03, "最後只剩下"], [225.8, 229.8, "我。"]],
