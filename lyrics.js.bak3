"e22b16eefe":[[3.06, 9.56, "玄關的燈 還亮著"], [16.52, 23.0, "像一個 沒說完的句子"], [23.0, 25.82, "你走的那天 沒有下雨"], [25.82, 29.57, "連天氣都 沒有配合我的悲劇"], [29.57, 32.61, "鞋櫃空出一格"], [32.61, 35.97, "剛好是心臟的位置"], [35.97, 39.98, "冰箱裡還有你買的那罐"], [39.98, 43.04, "過期了 我也捨不得丟"], [43.04, 45.76, "我把日子照舊過"], [45.76, 50.4, "只是每一格 都空了一半"], [50.4, 53.6, "我學會了 煮一人份"], [53.6, 56.92, "卻總是 多盛一碗"], [56.92, 60.92, "我學會了 睡整張床"], [60.92, 64.02, "卻還是 睡在同一邊"], [64.02, 66.04, "我留了一盞燈"], [66.04, 70.15, "不是等你回來"], [70.15, 73.02, "是怕黑的那個人"], [73.02, 77.7, "從來都是我"], [77.7, 79.96, "你早就走出了門"], [79.96, 84.8, "是我還站在門後"], [84.8, 88.86, "替你留著 你不需要的溫柔"], [88.86, 95.36, "替我留著 最後一點藉口"], [99.82, 103.32, "朋友說 時間會處理"], [103.32, 106.37, "可是時間 它太不專業"], [106.37, 108.48, "它把你的名字"], [108.48, 113.38, "留在我最常按的那一格"], [113.38, 115.2, "把你的聲音"], [115.2, 117.08, "留在每一場雨裡"], [117.08, 120.91, "我把照片 收進最深的抽屜"], [120.91, 123.56, "卻連抽屜的位置"], [123.56, 128.02, "都記得太清楚"], [128.02, 131.1, "我以為 關掉燈"], [131.1, 134.42, "就能關掉你"], [134.42, 137.24, "可是黑暗裡"], [137.24, 141.02, "你反而更清晰"], [141.02, 145.0, "我留了一盞燈"], [145.0, 148.2, "不是等你回來"], [148.2, 150.74, "是我還沒學會"], [150.74, 155.14, "一個人的亮度"], [155.14, 157.8, "你把愛帶走的時候"], [157.8, 162.0, "太小心了"], [162.0, 164.64, "連一句 不甘心"], [164.64, 171.14, "都沒留給我"], [171.3, 174.72, "如果那天 我多說一句"], [174.72, 178.38, "如果那天 我少說一句"], [178.38, 180.48, "如果我沒有假裝"], [180.48, 181.16, "我沒事"], [181.16, 182.06, "那盞燈"], [182.06, 183.68, "是不是就不用"], [183.68, 184.86, "亮這麼久"], [184.86, 186.5, "今天 我終於"], [186.5, 188.2, "按下了開關"], [188.2, 189.68, "黑了三秒"], [189.68, 191.1, "我沒有哭"], [191.1, 193.12, "原來我可以"], [193.12, 194.88, "原來我一直可以"], [194.88, 196.52, "只是我"], [196.52, 198.02, "還不想"], [198.02, 199.96, "我留了一盞燈"], [199.96, 201.38, "最後一次"], [201.38, 204.62, "不是等你回來"], [204.62, 207.78, "是替我自己 照路"], [207.78, 209.02, "謝謝你曾經"], [209.02, 212.6, "讓我家很亮"], [212.6, 215.96, "現在 換我學會"], [215.96, 218.32, "自己發光"], [218.32, 223.64, "玄關的燈 滅了"], [223.64, 225.78, "像一個"], [225.78, 232.28, "終於說完的句子"], [233.52, 235.78, "晚安"], [235.78, 239.78, "不是再見"]],
