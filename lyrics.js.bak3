"4b72340a14":[[2.86, 6.45, "別回答 別回答"], [6.45, 11.83, "讓名字先離開我一下"], [11.83, 16.61, "如果世界只剩呼吸"], [16.61, 20.8, "我還是不是我啊"], [20.8, 25.36, "凌晨三點 天花板在旋轉"], [25.36, 30.24, "我把名字拆成無數個答案"], [30.24, 34.0, "每一個我 都比昨天勇敢"], [34.0, 40.06, "每一個我 又在下一秒推翻"], [40.06, 42.68, "我說可以 回音說不行"], [42.68, 45.16, "我向前一步 影子退兩步"], [45.16, 49.26, "明明還活著 卻一直證明"], [49.26, 55.75, "證明我有資格成為自己"], [55.75, 59.46, "燈一閃 一滅"], [59.46, 63.16, "心一明 一暗"], [63.16, 65.43, "我把自己推向光"], [65.43, 68.54, "又親手拉回黑暗"], [68.54, 70.96, "越靠近"], [70.96, 72.84, "越逃離"], [72.84, 75.32, "到底哪一個聲音"], [75.32, 78.5, "才是真的自己"], [78.5, 80.42, "我是我的噪音"], [80.42, 83.77, "也是我的回音"], [83.77, 86.64, "一半把我推向光"], [86.64, 88.48, "一半把我按回重力"], [88.48, 90.24, "我說我不行"], [90.24, 93.08, "又說我可以"], [93.08, 95.66, "如果兩個聲音都是真的"], [95.66, 97.5, "那就讓它們"], [97.5, 104.0, "一起呼吸"], [108.98, 111.19, "玻璃窗上 貼滿別人的星圖"], [111.19, 113.58, "每一條軌道 都寫好了去處"], [113.58, 115.84, "我沿著標準走了太久"], [115.84, 118.4, "竟忘了偏航 也可以是路"], [118.4, 120.96, "他們說飛得高 才叫自由"], [120.96, 122.96, "我把翅膀摺成一把尺"], [122.96, 125.64, "一寸一寸 量自己的不足"], [125.64, 126.76, "直到連天空"], [126.76, 128.54, "都變得太窄"], [128.54, 129.54, "再像一點"], [129.54, 130.84, "再好一點"], [130.84, 131.62, "再把自己"], [131.62, 133.15, "修成正確的形狀"], [133.15, 135.24, "可我越接近答案"], [135.24, 137.74, "越看不見"], [137.74, 141.81, "那個最不像答案的我"], [141.81, 147.48, "去了哪裡"], [147.48, 149.94, "我是我的噪音"], [149.94, 151.35, "也是我的回音"], [151.35, 153.72, "一半想證明存在"], [153.72, 157.28, "一半只想關掉聲音"], [157.28, 159.72, "我說我值得"], [159.72, 161.13, "又說我不配"], [161.13, 164.05, "繞著同一顆心"], [164.05, 166.46, "一圈 一圈"], [166.46, 170.6, "沒有終點"], [170.6, 173.3, "停"], [173.3, 179.42, "把掌聲關掉"], [179.42, 180.66, "把比較關掉"], [180.66, 181.98, "把明天也關掉"], [181.98, 183.1, "讓那個拼命"], [183.1, 184.3, "想成為誰的我"], [184.3, 185.51, "就在這裡"], [185.51, 186.76, "碎掉"], [186.76, 189.81, "碎成沒有名字的光"], [189.81, 192.22, "碎成沒有答案的我"], [192.22, 193.43, "我以為崩潰"], [193.43, 194.42, "就是墜落"], [194.42, 195.56, "原來只是"], [195.56, 196.38, "終於"], [196.38, 197.78, "鬆手"], [197.78, 198.64, "沒有更好"], [198.64, 199.64, "沒有更壞"], [199.64, 200.58, "沒有哪一個我"], [200.58, 201.92, "需要被淘汰"], [201.92, 203.32, "我第一次聽見"], [203.32, 204.33, "自己的呼吸"], [204.33, 207.22, "它沒有替我辯解"], [207.22, 210.9, "沒有告訴我應該去哪裡"], [210.9, 216.06, "它只是說"], [216.06, 217.8, "我在這裡"], [217.8, 220.27, "我是我的噪音"], [220.27, 223.26, "也是我的回音"], [223.26, 225.29, "我不必消滅哪一個自己"], [225.29, 227.72, "才算完整的生命"], [227.72, 230.06, "讓懷疑坐在左邊"], [230.06, 232.28, "讓勇氣坐在右邊"], [232.28, 234.7, "我帶著它們一起"], [234.7, 237.68, "穿過自己的天際"], [237.68, 239.92, "在我的星球裡"], [239.92, 242.24, "沒有正確的重力"], [242.24, 244.84, "我不用飛向任何人"], [244.84, 245.91, "才能證明我會飛"], [245.91, 246.31, "如果明天"], [246.0, 246.4, "我又懷疑"], [246.09, 246.49, "那也沒關係"], [246.2, 246.6, "我會繞回自己的心"], [246.38, 246.78, "再一次"], [246.45, 246.85, "認出自己"], [246.54, 246.94, "我就是我"], [246.63, 247.03, "不必同意"], [246.72, 247.12, "我就是我"], [246.81, 247.21, "還在呼吸"], [246.9, 247.3, "張開雙手"], [246.99, 247.39, "讓世界失去重力"], [247.15, 247.55, "這一次"], [247.22, 247.62, "我。"], [247.27, 247.67, "不去哪裡"], [247.33, 247.73, "我只是在"], [247.42, 247.82, "自己的天空裡"], [247.55, 247.95, "飛行"], [247.6, 250.1, "我說我不行"], [250.1, 252.62, "我說我可以"], [252.62, 254.16, "兩個聲音"], [254.16, 257.81, "慢慢重疊在一起"], [257.81, 264.31, "最後只剩下"], [265.89, 266.29, "我。"]],
