"e03cd145b7":[[3.92, 10.42, "玄關的燈 還亮著"], [11.0, 17.5, "像一個 沒說完的句子"], [20.82, 24.18, "你走的那天 沒有下雨"], [24.18, 27.78, "連天氣都 沒有配合我的悲劇"], [27.78, 30.52, "鞋櫃空出一格"], [30.52, 33.69, "剛好是心臟的位置"], [33.69, 38.52, "冰箱裡還有你買的那罐"], [38.52, 41.98, "過期了 我也捨不得丟"], [41.98, 44.52, "我把日子照舊過"], [44.52, 48.96, "只是每一格 都空了一半"], [48.96, 52.44, "我學會了 煮一人份"], [52.44, 55.98, "卻總是 多盛一碗"], [55.98, 59.1, "我學會了 睡整張床"], [59.1, 62.76, "卻還是 睡在同一邊"], [62.76, 65.84, "我留了一盞燈"], [65.84, 69.26, "不是等你回來"], [69.26, 72.76, "是怕黑的那個人"], [72.76, 76.64, "從來都是我"], [76.64, 79.98, "你早就走出了門"], [79.98, 82.3, "是我還站在門後"], [82.3, 85.78, "替你留著 你不需要的溫柔"], [85.78, 92.28, "替我留著 最後一點藉口"], [101.92, 105.36, "朋友說 時間會處理"], [105.36, 109.16, "可是時間 它太不專業"], [109.16, 111.68, "它把你的名字"], [111.68, 115.76, "留在我最常按的那一格"], [115.76, 117.22, "把你的聲音"], [117.22, 119.68, "留在每一場雨裡"], [119.68, 122.94, "我把照片 收進最深的抽屜"], [122.94, 125.84, "卻連抽屜的位置"], [125.84, 130.26, "都記得太清楚"], [130.26, 132.78, "我以為 關掉燈"], [132.78, 134.58, "就能關掉你"], [134.58, 136.3, "可是黑暗裡"], [136.3, 138.06, "你反而更清晰"], [138.06, 140.62, "我留了一盞燈"], [140.62, 143.44, "不是等你回來"], [143.44, 146.3, "是我還沒學會"], [146.3, 150.76, "一個人的亮度"], [150.76, 153.06, "你把愛帶走的時候"], [153.06, 157.84, "太小心了"], [157.84, 160.18, "連一句 不甘心"], [160.18, 166.68, "都沒留給我"], [180.18, 183.7, "如果那天 我多說一句"], [183.7, 186.1, "如果那天 我少說一句"], [186.1, 188.2, "如果我沒有假裝"], [188.2, 188.98, "我沒事"], [188.98, 189.92, "那盞燈"], [189.92, 192.4, "是不是就不用"], [192.4, 196.02, "亮這麼久"], [196.02, 197.82, "今天 我終於"], [197.82, 199.36, "按下了開關"], [199.36, 201.08, "黑了三秒"], [201.08, 202.96, "我沒有哭"], [202.96, 204.58, "原來我可以"], [204.58, 206.74, "原來我一直可以"], [206.74, 207.92, "只是我"], [207.92, 209.5, "還不想"], [209.5, 211.56, "我留了一盞燈"], [211.56, 212.86, "最後一次"], [212.86, 215.72, "不是等你回來"], [215.72, 218.7, "是替我自己 照路"], [218.7, 220.46, "謝謝你曾經"], [220.46, 222.38, "讓我家很亮"], [222.38, 224.42, "現在 換我學會"], [224.42, 226.32, "自己發光"], [226.32, 232.6, "玄關的燈 滅了"], [232.6, 234.06, "像一個"], [234.06, 238.24, "終於說完的句子"], [238.24, 240.21, "晚安"], [240.21, 244.21, "不是再見"]],
