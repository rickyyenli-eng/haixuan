"d3129682ef":[[5.36, 11.86, "桌次牌上寫著我在第十二桌"], [11.96, 16.41, "紅包拿出來又放回口袋兩次"], [16.41, 21.04, "司儀把你的名字念得很好聽"], [21.04, 26.64, "新郎不知道我跟你交往過四年"], [26.64, 29.6, "麥克風在後台調了很久"], [29.6, 32.42, "有人翻著點歌的本子"], [32.42, 38.92, "不要點那首歌"], [160.06, 162.26, "隨便哪一首都可以"], [162.26, 166.06, "不要點那首歌"], [166.06, 168.57, "我怕我唱得太好"], [168.57, 169.89, "前奏一響"], [169.89, 171.54, "我就站不住"], [171.54, 172.86, "前奏一響"], [172.86, 173.8, "我就想坐下"], [173.8, 174.49, "你母親認得我她對我點了頭"], [174.49, 175.18, "主桌第二個位子以前是我的"], [175.18, 175.88, "伴娘裡有一個是我們的朋友"], [175.88, 176.63, "她假裝不認識我這樣比較方便"], [176.63, 177.21, "投影幕在放你們的照片"], [177.21, 177.73, "有一張是在我家樓下"], [177.73, 178.13, "不要點那首歌"], [178.07, 178.54, "隨便哪一首都可以"], [178.54, 178.94, "不要點那首歌"], [178.88, 179.29, "我怕我唱得太好"], [179.29, 179.69, "前奏一響"], [179.52, 179.92, "我就站不住"], [179.81, 180.21, "前奏一響"], [180.04, 181.02, "我就想坐下"], [181.02, 181.42, "其實那首歌是我點的"], [181.07, 181.47, "四年前的那一天你"], [181.12, 181.52, "唱到一半哭出來"], [181.17, 181.57, "我以為那是好事"], [181.22, 181.62, "你今天很漂亮"], [181.27, 181.67, "這句話我練了一個禮拜"], [181.32, 181.72, "上台之前我還在背"], [181.37, 181.77, "結果我只說了恭喜"], [181.42, 181.82, "不要點那首歌"], [181.47, 181.87, "隨便哪一首都可以"], [181.52, 181.92, "不要點那首歌"], [181.57, 181.97, "我怕我唱得太好"], [181.62, 182.02, "前奏一響"], [181.67, 182.07, "我就站不住"], [181.72, 182.12, "前奏一響"], [181.77, 183.57, "我就想坐下"], [183.57, 188.06, "敬酒的時候你走到我這一桌"], [188.06, 193.1, "我把杯子舉高擋住自己的臉"], [193.1, 197.34, "你說謝謝你來我說恭喜你們"], [197.34, 201.02, "這是四年來我們講過最短的話"], [201.02, 207.52, "主持人叫新娘朋友上台"], [208.46, 211.06, "我站起來的時候腿軟"], [211.06, 213.6, "不要點那首歌"], [213.6, 220.1, "隨便哪一首都可以"], [224.14, 225.82, "不要點那首歌"], [225.82, 226.64, "我怕我唱得太好"], [226.64, 227.11, "前奏一響"], [227.11, 227.7, "我就站不住"], [227.7, 228.17, "前奏一響"], [228.17, 228.75, "我就想坐下"], [228.75, 232.75, "不要點那首歌"]],
