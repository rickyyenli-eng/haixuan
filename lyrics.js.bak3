"b289f2b145":[[5.74, 10.63, "走廊的燈整晚都沒有關過"], [10.63, 16.98, "護理站的鍵盤一直在響著"], [16.98, 22.58, "你手機剩下百分之三沒人充"], [22.58, 29.08, "那天是我叫你出門幫我買東西"], [29.18, 33.42, "你的手還是熱的"], [33.42, 38.68, "我一直握著沒有放開過"], [38.68, 41.79, "醒過來罵"], [41.79, 45.83, "我罵我哪一次都可"], [45.83, 46.54, "以"], [46.54, 49.39, "醒過來罵"], [49.39, 55.04, "我我把話都留著沒有講"], [55.04, 57.29, "完"], [57.29, 63.79, "消毒水的味道我已經習慣"], [67.4, 72.09, "你的名字寫在門口的牌子"], [72.09, 77.93, "會客時間只有兩個小時很短"], [77.93, 84.43, "醫生說話的時候我一直看地板"], [85.34, 89.84, "你的戒指他們收"], [89.84, 92.56, "走了我幫你收在口"], [92.56, 95.48, "袋裡"], [95.48, 98.33, "醒過來罵"], [98.33, 102.45, "我罵我哪一次都可"], [102.45, 103.47, "以"], [103.47, 107.54, "醒過來罵"], [107.54, 111.5, "我我把話都留著沒有講"], [111.5, 118.0, "完"], [119.44, 123.12, "他們說要有心理準備"], [123.12, 129.62, "我說我準備了三十年了"], [129.78, 135.04, "準備怎麼吵架怎麼跟你道歉"], [135.04, 138.56, "沒有準備過這個"], [138.56, 145.06, "機器的聲音很規律"], [145.38, 150.08, "像你以前打呼的樣子"], [150.08, 153.74, "我聽著聽著睡著了"], [153.74, 160.24, "販賣機退了一枚硬幣給我"], [161.16, 166.18, "我在走廊坐到天亮了三次"], [166.18, 171.22, "你妹妹說要不要先回去休息"], [171.22, 177.72, "我說我再等一下他就快要醒了"], [179.06, 183.18, "我把該說的都說"], [183.18, 186.03, "完了剩下的等你自"], [186.03, 189.76, "己聽"], [189.76, 191.72, "醒過來罵"], [191.72, 195.59, "我罵我哪一次都可"], [195.59, 197.48, "以"], [197.48, 200.56, "醒過來罵"], [200.56, 204.7, "我我把話都留著沒有講"], [204.7, 207.48, "完"], [207.48, 210.0, "醒來看我"], [210.0, 214.48, "看我一下就好"], [214.48, 218.06, "醒來看我"], [218.06, 222.03, "我什麼都答應"], [222.03, 225.22, "醒過來罵"], [225.22, 228.42, "我我在等"], [228.42, 230.39, "你"]],
"2e610eec4b":[[12.16, 14.82, "安全帶 喀一聲"], [14.82, 17.36, "把我扣在"], [17.36, 23.66, "剛剛好的距離"], [23.66, 25.75, "你說順路 那就上車吧"], [25.75, 27.74, "其實我家 在反方向"], [27.74, 29.98, "我按掉導航的提醒"], [29.98, 30.9, "讓它以為"], [30.9, 32.86, "我們沒有要去哪"], [32.86, 35.46, "儀表板的光 照著你的側臉"], [35.46, 38.36, "我把視線 放在前擋玻璃"], [38.36, 40.42, "可是玻璃會反射"], [40.42, 43.4, "把我出賣得剛剛好"], [43.4, 45.8, "你問我 要不要放歌"], [45.8, 47.58, "我說都可以"], [47.58, 48.79, "其實我想說"], [48.79, 51.51, "這首 我聽了一整年"], [51.51, 52.15, "每一次"], [52.15, 54.16, "都在想你"], [54.16, 56.46, "我坐在你的右邊"], [56.46, 59.48, "中間只有一個扶手的距離"], [59.48, 61.48, "近到能聽見"], [61.48, 64.46, "你換氣的縫隙"], [64.46, 66.84, "遠到不能問你"], [66.84, 69.36, "這條路 要開去哪裡"], [69.36, 71.16, "副駕駛的規矩是"], [71.16, 72.75, "不能碰方向盤"], [72.75, 73.93, "只能陪你"], [73.93, 80.27, "往你要的方向 偏"], [80.27, 86.77, "紅燈的時候 你會轉頭看我"], [87.1, 89.66, "我就假裝 在看窗外"], [89.66, 91.94, "路燈一格一格"], [91.94, 94.88, "把心跳 量成節拍"], [94.88, 97.4, "你說我最近好像變安靜"], [97.4, 98.72, "我笑一笑"], [98.72, 100.52, "沒說 安靜的人"], [100.52, 102.98, "其實正在很大聲地"], [102.98, 105.52, "喜歡你"], [105.52, 107.92, "如果我說出來"], [107.92, 109.14, "這條路"], [109.14, 110.78, "會不會就不能再開"], [110.78, 112.22, "如果我不說"], [112.22, 113.92, "是不是就能"], [113.92, 116.06, "一直坐在這裡"], [116.06, 118.44, "我坐在你的右邊"], [118.44, 120.78, "把喜歡調成靜音"], [120.78, 123.26, "近到能數清"], [123.26, 126.06, "你袖口的皺褶"], [126.06, 128.78, "遠到只能祝你"], [128.78, 130.26, "一路 順利"], [130.26, 133.08, "副駕駛的規矩是"], [133.08, 134.16, "不能問終點"], [134.16, 136.14, "只能在每一個路口"], [136.14, 138.36, "悄悄希望"], [138.36, 144.86, "你不要轉彎"], [147.35, 153.85, "車停在我家樓下"], [164.32, 165.32, "你說 到了"], [165.32, 167.08, "我解開安全帶"], [167.08, 169.44, "用了比平常"], [169.44, 170.38, "慢三秒"], [170.38, 171.88, "那三秒裡"], [171.88, 174.8, "我把一整年的話"], [174.8, 177.2, "說完了"], [177.2, 179.24, "你沒有聽見"], [179.24, 182.82, "那就好"], [182.82, 185.48, "我坐過你的右邊"], [185.48, 186.83, "那就夠了"], [186.83, 189.31, "夠我在很多個夜裡"], [189.31, 193.14, "重播那條路"], [193.14, 194.68, "如果有一天"], [194.68, 198.04, "換別人坐在那裡"], [198.04, 199.64, "我會記得"], [199.64, 201.47, "副駕駛的座椅"], [201.47, 203.36, "是溫的"], [20