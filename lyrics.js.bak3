"9f6ede362d":[[6.94, 11.44, "走廊的燈整晚都沒有關過"], [11.44, 16.57, "護理站的鍵盤一直在響著"], [16.57, 22.66, "你手機剩下百分之三沒人充"], [22.66, 28.62, "那天是我叫你出門幫我買東西"], [28.62, 33.48, "你的手還是熱的"], [33.48, 37.98, "我一直握著沒有放開過"], [37.98, 39.99, "醒過來罵"], [39.99, 43.18, "我罵我哪一次都可"], [43.18, 45.68, "以"], [45.68, 47.53, "醒過來罵"], [47.53, 51.92, "我我把話都留著沒有講"], [51.92, 54.95, "完"], [54.95, 61.45, "消毒水的味道我已經習慣"], [64.48, 68.25, "你的名字寫在門口的牌子"], [68.25, 72.05, "會客時間只有兩個小時很短"], [72.05, 76.94, "醫生說話的時候我一直看地板"], [76.94, 79.26, "你的戒指他們收"], [79.26, 83.36, "走了我幫你收在口"], [83.36, 85.6, "袋裡"], [85.6, 87.5, "醒過來罵"], [87.5, 90.69, "我罵我哪一次都可"], [90.69, 92.9, "以"], [92.9, 94.84, "醒過來罵"], [94.84, 100.06, "我我把話都留著沒有講"], [100.06, 106.56, "完"], [108.37, 111.96, "他們說要有心理準備"], [111.96, 116.26, "我說我準備了三十年了"], [116.26, 120.24, "準備怎麼吵架怎麼跟你道歉"], [120.24, 126.74, "沒有準備過這個"], [128.66, 132.4, "機器的聲音很規律"], [132.4, 137.0, "像你以前打呼的樣子"], [137.0, 142.3, "我聽著聽著睡著了"], [142.3, 148.16, "販賣機退了一枚硬幣給我"], [148.16, 153.12, "我在走廊坐到天亮了三次"], [153.12, 156.7, "你妹妹說要不要先回去休息"], [156.7, 160.12, "我說我再等一下他就快要醒了"], [160.12, 165.11, "我把該說的都說"], [165.11, 170.74, "完了剩下的等你自"], [170.74, 173.36, "己聽"], [173.36, 176.03, "醒過來罵"], [176.03, 180.05, "我罵我哪一次都可"], [180.05, 182.5, "以"], [182.5, 184.74, "醒過來罵"], [184.74, 188.26, "我我把話都留著沒有講"], [188.26, 191.8, "完"], [191.8, 194.32, "醒來看我"], [194.32, 196.52, "看我一下就好"], [196.52, 199.7, "醒來看我"], [199.7, 202.66, "我什麼都答應"], [202.66, 206.8, "醒過來罵"], [206.8, 208.9, "我我在等"], [208.9, 212.71, "你"]],
"0c294d622a":[[7.54, 12.61, "玄關的燈 還亮著"], [12.61, 19.11, "像一個 沒說完的句子"], [28.28, 30.98, "你走的那天 沒有下雨"], [30.98, 34.39, "連天氣都 沒有配合我的悲劇"], [34.39, 37.2, "鞋櫃空出一格"], [37.2, 41.56, "剛好是心臟的位置"], [41.56, 44.71, "冰箱裡還有你買的那罐"], [44.71, 48.14, "過期了 我也捨不得丟"], [48.14, 50.92, "我把日子照舊過"], [50.92, 55.62, "只是每一格 都空了一半"], [55.62, 58.64, "我學會了 煮一人份"], [58.64, 62.08, "卻總是 多盛一碗"], [62.08, 65.72, "我學會了 睡整張床"], [65.72, 69.26, "卻還是 睡在同一邊"], [69.26, 72.54, "我留了一盞燈"], [72.54, 74.84, "不是等你回來"], [74.84, 78.42, "是怕黑的那個人"], [78.42, 81.56, "從來都是我"], [81.56, 85.24, "你早就走出了門"], [85.24, 89.07, "是我還站在門後"], [89.07, 94.86, "替你留著 你不需要的溫柔"], [94.86, 101.36, "替我留著 最後一點藉口"], [119.28, 121.46, "朋友說 時間會處理"], [121.46, 125.39, "可是時間 它太不專業"], [125.39, 127.44, "它把你的名字"], [127.44, 133.34, "留在我最常按的那一格"], [133.34, 134.96, "把你的聲音"], [134.96, 136.78, "留在每一場雨裡"], [136.78, 140.2, "我把照片 收進最深的抽屜"], [140.2, 142.78, "卻連抽屜的位置"], [142.78, 147.46, "都記得太清楚"], [147.46, 149.5, "我以為 關掉燈"], [149.5, 151.28, "就能關掉你"], [151.28, 153.14, "可是黑暗裡"], [153.14, 154.8, "你反而更清晰"], [154.8, 157.48, "我留了一盞燈"], [157.48, 160.52, "不是等你回來"], [160.52, 163.02, "是我還沒學會"], [163.02, 167.16, "一個人的亮度"], [167.16, 170.04, "你把愛帶走的時候"], [170.04, 172.53, "太小心了"], [172.53, 175.78, "連一句 不甘心"], [175.78, 182.28, "都沒留給我"], [183.99, 187.22, "如果那天 我多說一句"], [187.22, 190.12, "如果那天 我少說一句"], [190.12, 192.26, "如果我沒有假裝"], [192.26, 193.2, "我沒事"], [193.2, 194.38, "那盞燈"], [194.38, 195.98, "是不是就不用"], [195.98, 202.48, "亮這麼久"], [215.28, 216.04, "今天 我終於"], [216.04, 218.22, "按下了開關"], [218.22, 219.44, "黑了三秒"], [219.44, 220.96, "我沒有哭"], [220.96, 223.18, "原來我可以"], [223.18, 226.82, "原來我一直可以"], [226.82, 228.18, "只是我"], [228.18, 231.64, "還不想"], [231.64, 233.62, "我留了一盞燈"], [233.62, 235.52, "最後一次"], [235.52, 237.92, "不是等你回來"], [237.92, 240.66, "是替我自己 照路"], [240.66, 245.53, "謝謝你曾經"], [245.53, 248.37, "讓我家很亮"], [248.37, 253.03, "現在 換我學會"], [253.03, 258.4, "自己發光"], [258.4, 264.9, "玄關的燈 滅了"], [265.7, 267.9, "像一個"], [267.9, 274.4, "終於說完的句子"], [274.56, 275.9, "晚安"], [275.9, 279.9, "不是再見"]],
"8065f3d460":[[15.46, 17.62, "今天天氣很好"], [17.62, 19.38, "好到有一點"], [19.38, 21.62, "不習慣"], [21.62, 24.82, "早上醒來 沒有先看手機"], [24.82, 25.96, "這件事"], [25.96, 28.01, "我練習了半年"], [28.01, 29.96, "窗簾拉開"], [29.96, 31.64, "陽光沒有問我"], [31.64, 33.29, "過得好不好"], [33.29, 34.7, "它只是進來"], [34.7, 36.1, "把房間曬得"], [36.1, 37.32, "有一點暖"], [37.32, 38.74, "我煮了咖啡"], [38.74, 40.12, "剛好一人份"], [40.12, 41.09, "沒有多"], [41.09, 43.36, "以前遇到好天氣"], [43.36, 45.04, "第一個念頭是"], [45.04, 46.94, "拍給你看"], [46.94, 48.94, "今天我拍了"], [48.94, 50.48, "存在相簿裡"], [50.48, 53.5, "沒有傳出去"], [53.5, 53.9, "然後"], [53.82, 58.12, "我笑了一下"], [58.12, 60.38, "今天天氣很好"], [60.38, 62.48, "我沒有想告訴你"], [62.48, 64.14, "這是第一次"], [64.14, 66.26, "不是我不想你"], [66.26, 68.54, "是我終於可以"], [68.54, 70.58, "只是自己好"], [70.58, 72.86, "風有點涼"], [72.86, 73.68, "路很長"], [73.68, 76.4, "我走得比從前慢"], [76.4, 77.88, "可是每一步"], [77.88, 82.26, "都是我要去的方向"], [82.26, 86.05, "路上經過我們常去的那家店"], [86.05, 87.18, "我進去了"], [87.18, 88.78, "坐了以前的位置"], [88.78, 90.16, "點了一杯"], [90.16, 91.94, "你從來不喝的"], [91.94, 93.38, "意外地 好喝"], [93.38, 94.9, "原來有些位置"], [94.9, 97.0, "不是為了紀念誰"], [97.0, 99.08, "只是採光比較好"], [99.08, 101.18, "我沒有恨你"], [101.18, 102.7, "也沒有原諒"], [102.7, 103.62, "我只是"], [103.62, 105.93, "把行李放下了"], [105.93, 108.51, "它太重了"], [108.51, 109.8, "而路"], [109.8, 111.54, "還很長"], [111.54, 113.24, "今天天氣很好"], [113.24, 115.32, "我沒有想告訴你"], [115.32, 117.34, "而且我發現"], [117.34, 118.64, "我不難過"], [118.64, 120.1, "謝謝你來過"], [120.1, 121.48, "謝謝你走了"], [121.48, 123.44, "兩句都是真的"], [123.44, 126.44, "兩句我都說得出口"], [126.44, 128.76, "風有點涼"], [128.76, 130.5, "心很輕"], [130.5, 133.0, "我終於不用回頭"], [133.0, 135.52, "確認有沒有人跟上"], [135.52, 137.0, "如果哪天"], [137.0, 139.02, "我們在路上遇到"], [139.02, 140.14, "我會點頭"], [140.14, 141.6, "會說好久不見"], [141.6, 145.12, "會問你過得好嗎"], [145.12, 146.32, "然後真的"], [146.32, 147.26, "希望你好"], [147.26, 148.9, "不是逞強"], [148.9, 152.42, "是真的"], [152.42, 154.12, "因為我現在"], [154.12, 160.62, "也很好"], [172.56, 177.04, "今天天氣很好"], [177.04, 179.34, "我要出門了"], [179.34, 180.84, "不為了誰"], [180.84, 182.4, "只是想走走"], [182.4