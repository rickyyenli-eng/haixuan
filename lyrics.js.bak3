"78b77444c6":[[0.44, 4.84, "安全帶 喀一聲"], [4.84, 7.32, "把我扣在"], [7.32, 13.82, "剛剛好的距離"], [20.96, 23.65, "你說順路 那就上車吧"], [23.65, 25.76, "其實我家 在反方向"], [25.76, 28.22, "我按掉導航的提醒"], [28.22, 29.48, "讓它以為"], [29.48, 32.01, "我們沒有要去哪"], [32.01, 35.82, "儀表板的光 照著你的側臉"], [35.82, 38.59, "我把視線 放在前擋玻璃"], [38.59, 41.84, "可是玻璃會反射"], [41.84, 46.86, "把我出賣得剛剛好"], [46.86, 49.82, "你問我 要不要放歌"], [49.82, 52.66, "我說都可以"], [52.66, 54.71, "其實我想說"], [54.71, 58.74, "這首 我聽了一整年"], [58.74, 60.8, "每一次"], [60.8, 62.22, "都在想你"], [62.22, 64.82, "我坐在你的右邊"], [64.82, 69.85, "中間只有一個扶手的距離"], [69.85, 72.62, "近到能聽見"], [72.62, 74.76, "你換氣的縫隙"], [74.76, 77.68, "遠到不能問你"], [77.68, 80.29, "這條路 要開去哪裡"], [80.29, 83.3, "副駕駛的規矩是"], [83.3, 86.16, "不能碰方向盤"], [86.16, 87.97, "只能陪你"], [87.97, 94.47, "往你要的方向 偏"], [94.73, 101.23, "紅燈的時候 你會轉頭看我"], [101.81, 103.98, "我就假裝 在看窗外"], [103.98, 106.04, "路燈一格一格"], [106.04, 109.06, "把心跳 量成節拍"], [109.06, 111.56, "你說我最近好像變安靜"], [111.56, 112.92, "我笑一笑"], [112.92, 114.41, "沒說 安靜的人"], [114.41, 117.26, "其實正在很大聲地"], [117.26, 120.3, "喜歡你"], [120.3, 122.34, "如果我說出來"], [122.34, 123.16, "這條路"], [123.16, 126.06, "會不會就不能再開"], [126.06, 129.88, "如果我不說"], [129.88, 131.98, "是不是就能"], [131.98, 135.3, "一直坐在這裡"], [135.3, 137.98, "我坐在你的右邊"], [137.98, 140.61, "把喜歡調成靜音"], [140.61, 142.96, "近到能數清"], [142.96, 145.78, "你袖口的皺褶"], [145.78, 148.98, "遠到只能祝你"], [148.98, 150.74, "一路 順利"], [150.74, 154.32, "副駕駛的規矩是"], [154.32, 156.38, "不能問終點"], [156.38, 159.55, "只能在每一個路口"], [159.55, 161.16, "悄悄希望"], [161.16, 165.28, "你不要轉彎"], [165.28, 168.02, "車停在我家樓下"], [168.02, 169.48, "你說 到了"], [169.48, 171.5, "我解開安全帶"], [171.5, 172.98, "用了比平常"], [172.98, 174.15, "慢三秒"], [174.15, 176.22, "那三秒裡"], [176.22, 178.56, "我把一整年的話"], [178.56, 179.7, "說完了"], [179.7, 183.7, "你沒有聽見"], [183.7, 185.1, "那就好"], [185.1, 189.52, "我坐過你的右邊"], [189.52, 190.98, "那就夠了"], [190.98, 194.66, "夠我在很多個夜裡"], [194.66, 196.84, "重播那條路"], [196.84, 198.08, "如果有一天"], [198.08, 201.9, "換別人坐在那裡"], [201.9, 203.68, "我會記得"], [203.68, 206.54, "副駕駛的座椅"], [206.54, 210.26, "是溫的"], [